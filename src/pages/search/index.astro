---
import Base from '../../layouts/Base.astro';
import { content } from '../../lib/site';
const { subjects } = content();
---
<Base title="검색" nav="search" hideToggle>
  <div class="search-box">
    <input id="q" type="search" placeholder="이름, keyword, 태그, 출처 (예: 가우스, 2024 연세대)" autocomplete="off" enterkeyhint="search" />
    <div class="chips" id="filters">
      <button class="chip" type="button" data-subject="" aria-pressed="true">전체</button>
      {subjects.map((s) => <button class="chip" type="button" data-subject={s.id} aria-pressed="false">{s.name}</button>)}
    </div>
  </div>
  <p class="result-count" id="count"></p>
  <div class="cards" id="results"></div>
  <script>
    import '../../client/search';
  </script>
</Base>
