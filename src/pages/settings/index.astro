---
import Base from '../../layouts/Base.astro';
import { base, content } from '../../lib/site';
const { cards } = content();
const unverified = cards.filter((c) => !c.verified).length;
---
<Base title="설정" back={base}>
  <div class="panel">
    <h2>화면</h2>
    <div class="field">
      <span class="label">테마</span>
      <div class="seg" id="theme">
        <button type="button" data-v="system">시스템</button>
        <button type="button" data-v="light">라이트</button>
        <button type="button" data-v="dark">다크</button>
      </div>
    </div>
    <div class="field" style="margin-bottom:0">
      <span class="label">글자 크기</span>
      <div class="seg" id="font">
        <button type="button" data-v="0">작게</button>
        <button type="button" data-v="1">보통</button>
        <button type="button" data-v="2">크게</button>
        <button type="button" data-v="3">최대</button>
      </div>
    </div>
  </div>

  <div class="panel">
    <h2>백업 / 기기 간 이동</h2>
    <p class="small muted" style="margin-bottom:10px">
      즐겨찾기, 틀린 것, 설정은 이 기기 브라우저에만 저장됩니다.
      iPhone에서는 Safari와 홈 화면 앱의 저장소가 서로 별개이니, 옮길 때 이 기능을 쓰세요.
    </p>
    <p class="small" id="summary" style="margin-bottom:10px"></p>
    <div class="btn-row" style="margin-bottom:8px">
      <button class="btn" type="button" id="export-file">파일로 내보내기</button>
      <button class="btn" type="button" id="import-file">파일 가져오기</button>
    </div>
    <div class="btn-row">
      <button class="btn" type="button" id="export-copy">복사하기</button>
      <button class="btn" type="button" id="import-paste">붙여넣기</button>
    </div>
    <input type="file" id="file" accept="application/json,.json" hidden />
    <div id="paste-box" hidden style="margin-top:10px">
      <textarea id="paste" placeholder="백업 JSON을 붙여넣으세요"></textarea>
      <div class="btn-row" style="margin-top:8px">
        <button class="btn primary" type="button" id="paste-apply">가져오기 (현재 데이터 덮어씀)</button>
      </div>
    </div>
  </div>

  <div class="panel">
    <h2>콘텐츠</h2>
    <p class="small">카드 {cards.length}개{unverified > 0 && <> · <a href={`${base}review/`}>검토 필요 {unverified}개</a></>}</p>
  </div>

  <div class="panel">
    <h2>초기화</h2>
    <button class="btn danger" type="button" id="reset">즐겨찾기·틀린 것·설정 모두 지우기</button>
  </div>

  <script>
    import '../../client/settings';
  </script>
</Base>
