---
import Base from '../../layouts/Base.astro';
import { base } from '../../lib/site';
---
<Base title="학습 모드" back={base} nav="home">
  <section id="study" class="study-wrap">
    <div class="flash-top">
      <span id="s-where" class="small muted"></span>
      <span id="s-pos"></span>
    </div>
    <div class="progress"><i id="s-bar"></i></div>
    <div id="s-card" class="study-card"></div>
    <div class="answer-bar">
      <button id="s-prev" class="btn" type="button">이전</button>
      <button id="s-next" class="btn primary" type="button">다음</button>
    </div>
    <p class="empty" id="s-empty" hidden></p>
  </section>
  <script>
    import '../../client/study';
  </script>
</Base>
