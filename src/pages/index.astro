---
import Base from '../layouts/Base.astro';
import { icons } from '../lib/icons';
import { base, content, lessons, subjectHref } from '../lib/site';

const { subjects, cards } = content();
const unverified = cards.filter((c) => !c.verified).length;
const formulas = cards.filter((c) => c.kind === 'formula');
const problems = cards.filter((c) => c.kind === 'problem');
const tracks = lessons().tracks;
const count = (sid: string) => formulas.filter((c) => c.subject === sid).length;
---
<Base title="공식노트" nav="home">
  <a class="row continue-row" data-continue={JSON.stringify(tracks.map((t) => ({ title: t.title, lessons: t.lessons.map((l) => ({ id: l.id, n: l.n, title: l.title, href: l.href, minutes: l.minutes })) })))} hidden>
    <div class="row-main">
      <div class="row-sub" data-continue-label>이어서 읽기</div>
      <div class="row-title" data-continue-title></div>
    </div>
    <span class="chev" set:html={icons.chevron} />
  </a>
  {tracks.length > 0 && (
    <>
      <p class="section-title">물리 학습 · 이야기로 읽기</p>
      <div class="rows">
        {tracks.map((t) => (
          <a class="row" href={t.href}>
            <div class="row-main">
              <div class="row-title">{t.title}</div>
              <div class="row-sub">{t.subtitle ?? ''} · 레슨 {t.lessons.length}편 + 흐름도·비교·요약</div>
            </div>
            <span class="chev" set:html={icons.chevron} />
          </a>
        ))}
      </div>
    </>
  )}
  <p class="section-title">내 약점</p>
  <div class="rows">
    <a class="row" href={`${base}notes/`}>
      <div class="row-main">
        <div class="row-title">약점 메모</div>
        <div class="row-sub">약한 부분을 적어 두고, 모아서 클로드에게 정리 요청</div>
      </div>
      <span class="row-count" data-note-count></span>
      <span class="chev" set:html={icons.chevron} />
    </a>
  </div>
  <p class="section-title">문제 복습</p>
  <div class="rows">
    <a class:list={['row', { disabled: problems.length === 0 }]} href={`${base}problems/`}>
      <div class="row-main">
        <div class="row-title">문제</div>
        <div class="row-sub">과목·단원별 문제 · 핵심 아이디어 · 정답</div>
      </div>
      <span class="row-count">{problems.length}</span>
      <span class="chev" set:html={icons.chevron} />
    </a>
  </div>
  <p class="section-title">공식</p>
  <div class="rows">
    {subjects.map((s) => (
      <a class="row" href={subjectHref(s.id)}>
        <div class="row-main">
          <div class="row-title">{s.name}</div>
          <div class="row-sub">
            {s.name_en}{s.chapters.length > 1 && ` · ${s.chapters.length}개 단원`}
          </div>
        </div>
        <span class="row-count">{count(s.id)}</span>
        <span class="chev" set:html={icons.chevron} />
      </a>
    ))}
  </div>
  <p class="section-title">
    공식 {formulas.length}개 · 문제 {problems.length}개
    {unverified > 0 && <> · <a class="review-link" href={`${base}review/`}><span class="badge-review" /> 검토 필요 {unverified}개</a></>}
  </p>
  <script>
    import '../client/learn';
  </script>
</Base>
